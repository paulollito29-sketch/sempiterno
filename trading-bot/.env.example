# ======================================================================
# cryptobot — configuración del motor. Copia este archivo a .env y edita.
# NUNCA subas el .env a git (ya está en .gitignore).
# ======================================================================

# --- Qué vigila y cómo ejecutas ---------------------------------------
# Criptos de tu lista (las que operas en Lemon), separadas por coma
CRYPTOBOT_WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT
# manual (Lemon: recomienda y tú ejecutas) | paper (práctica) | semi_auto_api | auto_api
CRYPTOBOT_MODE=manual
# lemon | binance | binance_bnb  (define costos, horizonte y exigencia del bot)
CRYPTOBOT_COST_PROFILE=lemon
# Capital en USD que dedicas al bot (el tamaño de cada recomendación sale de aquí)
CRYPTOBOT_CAPITAL_USD=1000
# Hora UTC del resumen diario por Telegram (12 = 9:00 en Argentina, 7:00 en Perú)
CRYPTOBOT_SUMMARY_HOUR_UTC=12

# --- Telegram (avisos al celular) --------------------------------------
# 1) Crea un bot con @BotFather y copia el token.
# 2) Escríbele "hola" a tu bot y abre https://api.telegram.org/bot<TOKEN>/getUpdates para ver tu chat_id.
CRYPTOBOT_TELEGRAM_BOT_TOKEN=
CRYPTOBOT_TELEGRAM_CHAT_ID=

# --- Panel web (Supabase). Sin esto, se guarda en SQLite local ----------
# sqlite | supabase
CRYPTOBOT_STORE=sqlite
CRYPTOBOT_SUPABASE_URL=
# Clave de SERVICIO (service_role): solo en el servidor, NUNCA en el panel.
CRYPTOBOT_SUPABASE_SERVICE_KEY=

# --- Conector API (Fase 5). DESACTIVADO: déjalo así hasta pasar testnet --
CRYPTOBOT_ENABLE_LIVE_API=false
CRYPTOBOT_API_EXCHANGE=binance
# Claves con permisos de lectura + trading spot, RETIROS DESACTIVADOS, lista blanca de IP.
CRYPTOBOT_API_KEY=
CRYPTOBOT_API_SECRET=
# true = testnet (dinero de mentira). Pásalo a false solo después de semanas de pruebas.
CRYPTOBOT_API_SANDBOX=true

# --- Fuentes de datos públicas (no requieren claves) --------------------
# CRYPTOBOT_BINANCE_DATA_URL=https://data-api.binance.vision
# CRYPTOBOT_BINANCE_VISION_URL=https://data.binance.vision
# CRYPTOBOT_FNG_URL=https://api.alternative.me/fng/
CRYPTOBOT_LOG_LEVEL=INFO
